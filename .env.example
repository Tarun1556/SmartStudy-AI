DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/studyapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studyapp
POSTGRES_PORT=5432

JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BACKEND_PORT=8000

### REQUIRED FOR DEMO ###
# Pick ONE real LLM provider and set its key below. Without a key here,
# the app automatically falls back to LLM_PROVIDER=mock (deterministic,
# non-AI notes/answers) so it still runs, but that is NOT real GenAI.
# Values: openai | anthropic | gemini (or "google") | mock
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

### OPTIONAL ###
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Real semantic embeddings via sentence-transformers (downloads all-MiniLM-L6-v2
# on first use). Falls back to a deterministic MockEmbeddingProvider automatically
# if the model/package can't load (e.g. no internet). Set to "mock" to force
# the fallback intentionally for fast local dev/tests.
EMBEDDING_PROVIDER=sentence_transformers
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2

TOPIC_SIMILARITY_THRESHOLD=0.85

### DEVELOPMENT / MOCK ###
MAX_UPLOAD_SIZE_MB=100
